{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "cdc.public.transactions",
    "TopicDlq": "cdc.public.transactions.dlq",
    "GroupId": "fraud-lakehouse-consumer-group",
    "AutoOffsetReset": "Earliest",
    "EnableAutoCommit": false,
    "FetchMinBytes": 32768,
    "FetchWaitMaxMs": 100
  },
  "MinIO": {
    "Endpoint": "http://localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "lakehouse",
    "BronzePathPrefix": "bronze/transactions"
  },
  "Batching": {
    "MaxBatchSize": 5000,
    "FlushIntervalSeconds": 30,
    "ChannelCapacity": 50000
  },
  "Model": {
    "ModelPath": "models/fraud_model.onnx",
    "Threshold": 0.50
  }
}
